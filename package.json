{
  "name": "quire",
  "private": true,
  "version": "0.1.0",
  "description": "Merge, split, reorder and edit PDFs entirely on your own machine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
